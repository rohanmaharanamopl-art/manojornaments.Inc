# Security + caching headers. Read automatically by Cloudflare Pages and Netlify.
# (Other hosts simply ignore this file.)

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Admin page: never cached, never shown in Google
/admin.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# Product photos: browsers may keep them for one day
/*.jpeg
  Cache-Control: public, max-age=86400
/*.jpg
  Cache-Control: public, max-age=86400
/*.png
  Cache-Control: public, max-age=86400
/*.webp
  Cache-Control: public, max-age=86400
